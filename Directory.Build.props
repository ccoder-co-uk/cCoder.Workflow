<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'cCoder.Workflow.Activities'">
    <PackageReference Include="cCoder.CodeAnalysis" Version="2026.10.8.1211" IncludeAssets="analyzers;build;buildTransitive" PrivateAssets="all" />
    <PackageReference Include="cCoder.CodeAnalysis.Contracts" Version="2026.10.8.1211" />
  </ItemGroup>
  <ItemGroup>
    <!-- These direct pins intentionally override vulnerable transitive versions. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.14" NoWarn="NU1510" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" NoWarn="NU1510" />
  </ItemGroup>
</Project>
